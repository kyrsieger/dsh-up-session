{
  "name": "dsh-up-session",
  "version": "1.0.2",
  "type": "module",
  "description": "Adds pinned and recent session groups at the top of the workspace list in the DSH sidebar, with a small settings popup.",
  "license": "MIT",
  "author": "kyrsieger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyrsieger/dsh-up-session.git"
  },
  "homepage": "https://github.com/kyrsieger/dsh-up-session#readme",
  "bugs": {
    "url": "https://github.com/kyrsieger/dsh-up-session/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "session",
    "pinned",
    "recent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/*.png",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
